# ==============================================================================
# CryptoTrace AI - Environment Configuration Template
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development

# Blockchain Node Providers (Optional - Mock Provider active by default)
# Leave empty to run in deterministic, offline-capable Demo Mode
ETHEREUM_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
BNB_RPC_URL=https://bsc-dataseed.binance.org
POLYGON_RPC_URL=https://polygon-rpc.com
BITCOIN_RPC_URL=

# AI & LLM Assisted Forensics (Optional - Deterministic rule engine active by default)
# No sensitive victim data is ever transmitted to external AI endpoints
OPENAI_API_KEY=
GEMINI_API_KEY=

# Government & External Connectors (Mock adapters active by default)
NCRP_ADAPTER_MODE=SIMULATION
SAHYOG_ADAPTER_MODE=SIMULATION
VASP_CLUSTER_DB_MODE=ACTIVE_DEMO

# Evidence Preservation
EVIDENCE_HASH_ALGO=sha256
ANALYSIS_VERSION=v2.4.1-law-enforcement-edition
